-- -----------------------------------------------------
-- Table `Book_keeping`.`inventoy_items`
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `Book_keeping`.`inventoy_items` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
