COLLATE = utf8mb4_unicode_ci;


-- -----------------------------------------------------
-- Table `Book_keeping`.`sub_accont_for_new_account`
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `Book_keeping`.`sub_accont_for_new_account` (
