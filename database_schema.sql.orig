ENGINE = InnoDB
AUTO_INCREMENT = 6
DEFAULT CHARACTER SET = utf8mb4
COLLATE = utf8mb4_unicode_ci;


-- -----------------------------------------------------
-- Table `Book_keeping`.`suppliers`
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `Book_keeping`.`suppliers` (
  `sup_id` BIGINT NOT NULL AUTO_INCREMENT,
