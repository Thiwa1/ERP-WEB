COLLATE = utf8mb4_unicode_ci;


-- -----------------------------------------------------
-- Table `Book_keeping`.`new_account_table`
-- -----------------------------------------------------
-- -----------------------------------------------------
-- Table `Book_keeping`.`currency_table`
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `Book_keeping`.`currency_table` (
  `id` INT NOT NULL AUTO_INCREMENT,
